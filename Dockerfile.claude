# Claude Code interactive container.
# Runs the native claude binary as the invoking user -- the shared "claude"
# identity by default -- with the UID/GID and home directory path run.sh
# passes in, so bind-mounted ~/.claude, ~/.ssh and /scratch keep correct
# ownership. The host's ~/.claude credentials are bind-mounted read-write so a
# login persists; settings and ~/.claude.json are read-only seeds the entrypoint
# copies to writable paths, so the client recognises the existing authenticated
# install. The global CLAUDE.md is this repo's, baked into the image. All session state (conversations, history,
# memories) stays in the container and is discarded on exit. Includes the
# docker CLI (no daemon) for driving the host socket.
#
# BASE_IMAGE is overridable per host (hosts/<hostname>.sh, via run.sh) so a
# host with a GPU can build on an NVIDIA CUDA image instead; anything derived
# from ubuntu:24.04 works unchanged, since every layer below is apt/noble.
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

# Defaults describe the shared "claude" identity (UID 3001, "sw" group);
# run.sh overrides them with the invoking user's own values. The group is the
# host's "sw", shared by both identities, and is the user's *primary* group, so
# everything written in the container is owned by it without a chgrp.
ARG CONTAINER_USER=claude
ARG CONTAINER_GROUP=sw
ARG UID=3001
ARG GID=3001
# Must match the host's docker group so the mounted socket is writable.
ARG DOCKER_GID=998
# Home directory path: identical to the host, so $HOME-relative bind mounts
# (~/.ssh, ~/.claude, ~/.gitconfig, ...) land in the right place.
ARG HOME_DIR=/home/claude

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Use http for apt transport so a caching proxy can serve hits; the signed-by
# keyrings below still verify Release signatures, so packages stay authenticated.
# build-essential, python3-dev, pkg-config and gfortran are what a python sdist
# needs to compile and cannot get from the index itself; cmake, ninja and meson
# are wheels, so a PEP 517 backend pulls those in for itself.
RUN sed -i 's|https://|http://|g' \
        /etc/apt/sources.list /etc/apt/sources.list.d/*.sources 2>/dev/null || true; \
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg git openssh-client \
        ripgrep less jq python3 python3-pip python3-venv python3-dev \
        python3-pygments \
        build-essential pkg-config gfortran sudo time black clang-format

# Docker CLI only (talks to the bind-mounted host daemon socket).
# Stays on https: download.docker.com (CloudFront) 301-redirects http to https,
# so a caching proxy can't serve hits here regardless; http just adds a redirect.
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
        -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable" \
        > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli docker-buildx-plugin docker-compose-plugin

# GitHub CLI (uses the bind-mounted ~/.config/gh credentials).
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && chmod a+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] http://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh

# Create user/group matching the host. Reuse the GID if it already exists.
# Ubuntu 24.04 ships a default "ubuntu" user at UID/GID 1000; remove it first
# so it doesn't collide with the host-matched UID/GID below.
RUN userdel -r ubuntu 2>/dev/null || true; \
    if ! getent group "${GID}" >/dev/null; then groupadd -g "${GID}" "${CONTAINER_GROUP}"; fi \
    && useradd -l -m -u "${UID}" -g "${GID}" -d "${HOME_DIR}" -s /bin/bash "${CONTAINER_USER}" \
    && echo "${CONTAINER_USER} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/"${CONTAINER_USER}" \
    && chmod 0440 /etc/sudoers.d/"${CONTAINER_USER}" \
    && install -d -o "${UID}" -g "${GID}" -m 0700 "${HOME_DIR}/.claude"

# Group-writable by default, so what one identity in the shared "sw" group
# creates stays writable by the other. login.defs covers anything that goes
# through PAM, profile.d covers login shells (docker exec -l); the entrypoint
# sets it for the session itself, which is exec'd directly.
RUN sed -i 's/^UMASK.*/UMASK\t\t002/' /etc/login.defs \
    && echo 'umask 002' > /etc/profile.d/umask.sh

# docker group with the host's GID, so the user can use the mounted socket.
RUN if getent group "${DOCKER_GID}" >/dev/null; then \
        usermod -aG "$(getent group "${DOCKER_GID}" | cut -d: -f1)" "${CONTAINER_USER}"; \
    else \
        groupadd -g "${DOCKER_GID}" docker && usermod -aG docker "${CONTAINER_USER}"; \
    fi

USER ${CONTAINER_USER}
WORKDIR /scratch/anarkiwi/infra/claude

ENV PATH="${HOME_DIR}/.local/bin:${PATH}"

# Native claude install, laid out exactly as claude.ai/install.sh leaves it:
# the versioned binary under ~/.local/share (outside the mounted ~/.claude),
# with ~/.local/bin/claude a symlink to it, so the client's own update path
# still works. The binary itself arrives from "claude-dist", a named build
# context run.sh points at a version-keyed cache on the shared /scratch mount
# -- so a release is downloaded once for the whole fleet, not once per host,
# and this layer's cache key is the binary's content rather than a version
# string that must be guessed at.
ARG CLAUDE_VERSION
RUN install -d "${HOME_DIR}/.local/bin" "${HOME_DIR}/.local/share/claude/versions"
# hadolint ignore=DL3022
COPY --from=claude-dist --chown=${UID}:${GID} --chmod=0755 \
    claude "${HOME_DIR}/.local/share/claude/versions/${CLAUDE_VERSION}"
RUN ln -sf "${HOME_DIR}/.local/share/claude/versions/${CLAUDE_VERSION}" \
        "${HOME_DIR}/.local/bin/claude"

COPY --chmod=0755 entrypoint.sh /usr/local/bin/entrypoint.sh

# PreToolUse guards, referenced by settings.json at these absolute paths and run
# on the system python3: excess comment volume on Python writes, and unformatted
# content or a comment that will go stale on git commit (black, clang-format and
# pygments, installed above). commits.py is the shared git commit parsing the two
# commit guards import by module name, so it keeps its .py name beside them, in
# their own directory on sys.path.
COPY --chmod=0755 hooks/min_comments.py /usr/local/bin/min-comments-hook
COPY --chmod=0755 hooks/format_check.py /usr/local/bin/format-check-hook
COPY --chmod=0755 hooks/durable_comments.py /usr/local/bin/durable-comments-hook
COPY --chmod=0644 hooks/commits.py /usr/local/bin/commits.py

# Canonical shared settings (auto permission mode, allow list, guard hooks);
# the entrypoint overlays these on the host seed, so they apply without host
# changes.
COPY settings.json /usr/local/share/claude-settings.json

# This repo's coding directives, installed as the container's global CLAUDE.md,
# so every client gets them from the image rather than from a host file.
COPY --chown=${UID}:${GID} CLAUDE.md "${HOME_DIR}/.claude/CLAUDE.md"

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
